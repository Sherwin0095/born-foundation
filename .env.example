# BORN FOUNDATION — Environment Variable Template
# Copy to .env.local for local configuration (never commit real secrets).

# Offline Development Mode (true = localStorage sandbox, false = live Supabase)
NEXT_PUBLIC_OFFLINE_MODE=true

# Supabase Configuration (required only when NEXT_PUBLIC_OFFLINE_MODE=false)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only administrative key (NEVER expose to browser / NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public Canonical Origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=BORN FOUNDATION

# Optional Transactional Email & Payment Gateway Keys
# Keep disabled until official bank reconciliation, 12A/80G/FCRA verification,
# and executive authorisation are complete.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# PAYMENT_PROVIDER_KEY=
# PAYMENT_PROVIDER_SECRET=
# PAYMENT_WEBHOOK_SECRET=

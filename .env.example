# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Only needed for server-side admin operations (migrations, seeding)
# NEVER expose this in the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Born Foundation

# Email (configure when email service is ready)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Payment Provider (configure when ready for donations)
# PAYMENT_PROVIDER_KEY=
# PAYMENT_PROVIDER_SECRET=
# PAYMENT_WEBHOOK_SECRET=
